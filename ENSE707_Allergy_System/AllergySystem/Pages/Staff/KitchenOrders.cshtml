@page
@model AllergySystem.Pages.Staff.KitchenOrdersModel
@using AllergySystem.Models

@{
    ViewData["Title"] = "Kitchen Orders";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Kitchen Orders</h1>
        <p class="text-muted mb-0">
            View orders requiring kitchen attention and review allergen information before preparation.
        </p>
    </div>

    <span class="badge text-bg-secondary">
        @Model.KitchenOrders.Count kitchen-visible orders
    </span>
</div>

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success" role="status">
        @Model.SuccessMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        @Model.ErrorMessage
    </div>
}

@if (Model.KitchenOrders.Count == 0)
{
    <div class="alert alert-info">
        There are currently no orders requiring kitchen attention.
    </div>
}
else
{
    <div class="d-flex flex-column gap-4">
        @foreach (var order in Model.KitchenOrders)
        {
            var hasConflicts = order.ConflictingAllergens.Any();

            <div class="card @(hasConflicts ? "border-danger" : string.Empty)">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Order #@order.Id</strong>
                        <span class="text-muted ms-2">
                            Customer @order.CustomerId
                        </span>
                    </div>

                    <span class="badge text-bg-light">
                        @order.Status
                    </span>
                </div>

                <div class="card-body">

                    @if (hasConflicts)
                    {
                        <div class="alert alert-danger" role="alert">
                            <strong>Allergen conflict — DO NOT PREPARE</strong>

                            <div class="mt-2">
                                <strong>Conflicting allergens:</strong>

                                @foreach (var allergen in order.ConflictingAllergens)
                                {
                                    <span class="badge text-bg-danger ms-1">
                                        @allergen.Name
                                    </span>
                                }
                            </div>

                            <div class="mt-2">
                                @if (order.KitchenAllergyAcknowledged)
                                {
                                    <span class="badge text-bg-warning">
                                        Acknowledged by kitchen
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-danger">
                                        Not yet acknowledged
                                    </span>

                                    @if (order.Status == OrderStatus.PendingAllergyConfirmation)
                                    {
                                        <form method="post"
                                              asp-page-handler="AcknowledgeAllergy"
                                              class="mt-3">

                                            <input type="hidden"
                                                   name="orderId"
                                                   value="@order.Id" />

                                            <button type="submit"
                                                    class="btn btn-warning btn-sm">
                                                Acknowledge allergen warning
                                            </button>
                                        </form>
                                    }
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success" role="status">
                            No unresolved allergen conflicts.
                        </div>
                    }

                    @if (order.Status == OrderStatus.ReadyForKitchen && !order.ConflictingAllergens.Any() && order.Items.Any())
                    {
                        <div class="mb-3">
                            <form method="post"
                                  asp-page-handler="StartPreparation">

                                <input type="hidden"
                                       name="orderId"
                                       value="@order.Id" />

                                <button type="submit"
                                        class="btn btn-primary">
                                    Start Preparation
                                </button>
                            </form>
                        </div>
                    }

                    @if (order.Status == OrderStatus.InPreparation && !order.ConflictingAllergens.Any() && order.Items.Any())
                    {
                        <div class="mb-3">
                            <form method="post"
                                  asp-page-handler="CompleteOrder">

                                <input type="hidden"
                                       name="orderId"
                                       value="@order.Id" />

                                <button type="submit"
                                        class="btn btn-success"
                                        onclick="return confirm('Mark this order as completed?');">
                                    Complete Order
                                </button>
                            </form>
                        </div>
                    }

                    <div class="mb-3">
                        <strong>Created:</strong>
                        @order.CreatedAt.ToLocalTime().ToString("g")
                    </div>

                    <h5>Order Items</h5>

                    @foreach (var item in order.Items)
                    {
                        var itemContributesToConflict = item.MenuItem.Ingredients.SelectMany(ingredient => 
                        ingredient.Allergens).Any(allergen => order.ConflictingAllergens.Any(conflict => conflict.Id == allergen.Id));

                        <div class="border rounded p-3 mb-3">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <strong>@item.MenuItem.Name</strong>

                                    @if (order.Status == OrderStatus.PendingAllergyConfirmation &&
                                         order.KitchenAllergyAcknowledged &&
                                         itemContributesToConflict)
                                    {
                                        <form method="post"
                                              asp-page-handler="RemoveOrderItem"
                                              class="d-inline ms-2">

                                            <input type="hidden"
                                                   name="orderId"
                                                   value="@order.Id" />

                                            <input type="hidden"
                                                   name="menuItemId"
                                                   value="@item.MenuItem.Id" />

                                            <button type="submit"
                                                    class="btn btn-outline-danger btn-sm"
                                                    onclick="return confirm('Remove this entire menu item from the order?');">
                                                Remove item
                                            </button>
                                        </form>
                                    }
                                </div>

                                <span class="text-muted">
                                    Quantity: @item.Quantity
                                </span>
                            </div>

                            <div class="mt-2">
                                <strong>Ingredients</strong>

                                @if (!item.MenuItem.Ingredients.Any())
                                {
                                    <div class="text-muted">
                                        No ingredients listed.
                                    </div>
                                }
                                else
                                {
                                    <ul class="mb-0 mt-1">
                                        @foreach (var ingredient in item.MenuItem.Ingredients)
                                        {
                                            var conflictingAllergens =
                                                ingredient.Allergens
                                                    .Where(ingredientAllergen =>
                                                        order.ConflictingAllergens.Any(
                                                            conflict => conflict.Id == ingredientAllergen.Id))
                                                    .ToList();

                                            <li class="mb-1">
                                                @ingredient.Name

                                                @if (conflictingAllergens.Any())
                                                {
                                                    <span class="badge text-bg-danger ms-2">
                                                        Conflict:
                                                        @string.Join(", ", conflictingAllergens.Select(a => a.Name))
                                                    </span>

                                                    @if (order.Status == OrderStatus.PendingAllergyConfirmation &&
                                                         order.KitchenAllergyAcknowledged)
                                                    {
                                                        <form method="post"
                                                              asp-page-handler="RemoveIngredient"
                                                              class="d-inline ms-2">

                                                            <input type="hidden"
                                                                   name="orderId"
                                                                   value="@order.Id" />

                                                            <input type="hidden"
                                                                   name="menuItemId"
                                                                   value="@item.MenuItem.Id" />

                                                            <input type="hidden"
                                                                   name="ingredientId"
                                                                   value="@ingredient.Id" />

                                                            <button type="submit"
                                                                    class="btn btn-outline-danger btn-sm"
                                                                    onclick="return confirm('Remove this conflicting ingredient from the order?');">
                                                                Remove ingredient
                                                            </button>
                                                        </form>
                                                    }
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}