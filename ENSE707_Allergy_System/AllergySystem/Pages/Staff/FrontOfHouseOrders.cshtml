@page
@model AllergySystem.Pages.Staff.FrontOfHouseOrdersModel
@using AllergySystem.Models
@{
    ViewData["Title"] = "Front-of-House Orders";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Front-of-House Orders</h1>
        <p class="text-muted mb-0">Review active orders and send safe orders to the kitchen.</p>
    </div>
    <span class="badge text-bg-secondary">@Model.ActiveOrders.Count active</span>
</div>

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success" role="status">@Model.SuccessMessage</div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

@if (Model.ActiveOrders.Count == 0)
{
    <div class="alert alert-info">There are no active orders requiring FOH attention.</div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Order</th>
                    <th scope="col">Customer</th>
                    <th scope="col">Menu item</th>
                    <th scope="col">Created</th>
                    <th scope="col">Status</th>
                    <th scope="col">Allergy information</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.ActiveOrders)
                {
                    var hasConflicts = order.ConflictingAllergens.Count > 0;
                    <tr class="@(hasConflicts ? "table-danger" : string.Empty)">
                        <th scope="row">#@order.Id</th>
                        <td>@order.CustomerId</td>
                        <td>
                            @foreach (var item in order.Items)
                            {
                                <div>@item.MenuItem.Name <span class="text-muted">x @item.Quantity</span></div>
                            }
                        </td>
                        <td>@order.CreatedAt.ToLocalTime().ToString("g")</td>
                        <td><span class="badge text-bg-light">@order.Status</span></td>
                        <td>
                            @if (hasConflicts)
                            {
                                <strong>Allergy conflict: do not send to kitchen.</strong>
                                <div>Conflicting allergens: @string.Join(", ", order.ConflictingAllergens.Select(allergen => allergen.Name))</div>
                            }
                            else
                            {
                                <span>Safety check passed.</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-2 justify-content-end">
                                @if (!hasConflicts && order.Status == OrderStatus.Pending)
                                {
                                    <form method="post" asp-page-handler="SendToKitchen">
                                        <input type="hidden" name="orderId" value="@order.Id" />
                                        <button type="submit" class="btn btn-primary btn-sm">Send to kitchen</button>
                                    </form>
                                }
                                else if (hasConflicts)
                                {
                                    <span class="text-danger">Kitchen handoff unavailable until reviewed.</span>
                                }

                                @if (order.Status != OrderStatus.Completed &&
                                    order.Status != OrderStatus.Cancelled)
                                {
                                    <form method="post" asp-page-handler="Cancel">
                                        <input type="hidden" name="orderId" value="@order.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Cancel</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
