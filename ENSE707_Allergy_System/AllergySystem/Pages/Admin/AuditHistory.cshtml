@page
@model AllergySystem.Pages.Admin.AuditHistoryModel
@{
    ViewData["Title"] = "Audit History";
}

<div class="admin-audit-history-page">
    <h1>Audit History</h1>

    <p>Read-only audit history, newest first.</p>

    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-sm-4">
            <label asp-for="ActorRoleFilter" class="form-label">Actor role</label>
            <select asp-for="ActorRoleFilter" class="form-select">
                <option value="">All roles</option>
                @foreach (var role in Model.AvailableActorRoles)
                {
                    <option value="@role">@role</option>
                }
            </select>
        </div>
        <div class="col-sm-4">
            <label asp-for="ActionFilter" class="form-label">Action</label>
            <select asp-for="ActionFilter" class="form-select">
                <option value="">All actions</option>
                @foreach (var action in Model.AvailableActions)
                {
                    <option value="@action">@action</option>
                }
            </select>
        </div>
        <div class="col-sm-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Filter</button>
            <a asp-page="/Admin/AuditHistory" class="btn btn-outline-secondary">Clear</a>
        </div>
    </form>

    @if (Model.Entries.Count == 0)
    {
        <div class="admin-empty-state">
            There are no audit entries matching these filters.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped admin-audit-table">
                <thead>
                    <tr>
                        <th>Timestamp (UTC)</th>
                        <th>Actor Role</th>
                        <th>Action</th>
                        <th>Entity Type</th>
                        <th>Entity Id</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.Entries)
                    {
                        <tr>
                            <td>@entry.TimestampUtc.ToString("dd/MM/yyyy HH:mm 'UTC'")</td>
                            <td>@entry.ActorRole</td>
                            <td>@entry.Action</td>
                            <td>@entry.EntityType</td>
                            <td>@(entry.EntityId.HasValue ? entry.EntityId.Value.ToString() : "-")</td>
                            <td class="text-break">@entry.Details</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
